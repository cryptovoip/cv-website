# CORS — comma-separated list of site origins allowed to call /connect.
# In production set this to your live domains (no trailing slash).
ALLOWED_ORIGINS=https://cryptovoips.com,https://www.cryptovoips.com,https://cryptovoip.tech,https://cryptovoip.info,https://cryptovoips.info

# Daily WebRTC Transport
DAILY_API_KEY=get_your_key_from_dashboard.daily.co

# LLM Provider (Currently using OpenAI in bot.py, but you can swap to Anthropic/Groq etc)
OPENAI_API_KEY=get_your_key_from_platform.openai.com

# STT Provider (Deepgram is recommended for Pipecat)
DEEPGRAM_API_KEY=get_your_key_from_console.deepgram.com

# TTS Provider (Cartesia is recommended for conversational Voice bots)
CARTESIA_API_KEY=get_your_key_from_play.cartesia.ai

# ── Email for Callbacks (pick ONE provider) ───────────────────────────────────

# Option A — Resend (recommended, simpler)
# Sign up at resend.com, verify your sending domain, then paste the API key.
# RESEND_FROM must be an address on your verified domain (e.g. bot@cryptovoips.com).
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=bot@cryptovoips.com

# Option B — SMTP (legacy fallback, used only when RESEND_API_KEY is not set)
# Works with cPanel webmail or a Gmail App Password.
# SMTP_SERVER=mail.yourdomain.com_or_smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=bot@cryptovoip.in_or_gmail_address
# SMTP_PASS=your_email_password
